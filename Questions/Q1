class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        i = 0 
        j = 0
        HashMap = {}
        while i < len(nums):
            Compliment = target - nums[i]
            if Compliment in HashMap:
                    return[HashMap[Compliment],i]
            else:
                HashMap[nums[i]] = i   
            i = i + 1