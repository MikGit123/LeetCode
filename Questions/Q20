class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        mapping = {')': '(', '}': '{', ']': '['}
        stack = []
        
        for j in range(0,len(s)):
            char = s[j]
            if char in mapping:
                if len(stack) > 0 :
                    Value = stack.pop()
                    if Value != mapping[char]:
                        return False
                elif len(stack) == 0:
                    return False
            if char == "(" or char == "[" or char == "{":
                stack.append(char)
        if len(stack) == 0:
            return True
        else:
            return False
